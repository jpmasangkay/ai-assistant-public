# ==============================================================================
# Security & Environment Variables
# ==============================================================================
# Environment variable files (NEVER commit secrets or API keys)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.local

# Preserve example/template environment files for developer onboarding
!.env.example
!.env.sample
!.env.template

# Cloudflare / Wrangler local development secrets
.dev.vars
.dev.vars.*

# Certificates, private keys & keystores
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.keystore
id_rsa*
id_ed25519*

# API keys, service accounts & credentials
credentials.json
client_secret*.json
service-account*.json
*firebase-adminsdk*.json
secrets.json
auth.json
token.json
tokens.json

# Local databases, storage & backups
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.db-journal
*.dump
*.sql.gz
*.bak
*.backup

# Cloud provider CLI local cache & configs
.aws/
.gcp/
.azure/
.serverless/

# ==============================================================================
# Dependencies & Build Outputs
# ==============================================================================
node_modules/
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/**
.nitro/
.wrangler/
*.local

# ==============================================================================
# Logs & Diagnostic Files
# ==============================================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==============================================================================
# Editor & OS Metadata
# ==============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*~
*.orig

